DEBUG=false
# Use the Supabase connection string from Project Settings > Database.
# URL-encode special characters in the password, for example @ becomes %40.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_APP_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
# Optional: only needed if your project still issues legacy HS256 tokens.
SUPABASE_JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/strava/callback
